rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isSignedIn() {
      return request.auth != null;
    }

    // Public read for marketplace contractors, consultants, and public ads
    match /contractors/{contractorId} {
      allow read: if true;
      allow write: if true; // Allows demo operations and administrative controls
    }

    match /consultants/{consultantId} {
      allow read: if true;
      allow write: if true;
    }

    match /advertisements/{adId} {
      allow read: if true;
      allow write: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    match /estimates/{estimateId} {
      allow read: if true;
      allow write: if true;
    }

    match /inquiries/{inquiryId} {
      allow read: if true;
      allow write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
